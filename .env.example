APP_ENV=dev
APP_SECRET_KEY=change-me-to-32bytes-min-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
REDIS_URL=redis://localhost:6379/0

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 优先于 DEEPSEEK_*：可切到任意 OpenAI 兼容接口（Ollama/vLLM/其他云厂商）
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL_NAME=BAAI/bge-m3
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3

UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10
MAX_CONVERSATIONS_PER_USER=20
MAX_KNOWLEDGE_BASES_PER_TENANT=10
MAX_DOCUMENTS_PER_KB=5
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=5

WEATHER_API_KEY=
ENABLE_READONLY_SQL_TOOL=false
INLINE_DOCUMENT_PIPELINE=true
AGENT_MAX_ITERATIONS=10


CORS_ORIGINS=http://localhost:5173,http://localhost

PROJECT_NAME=enterprise-rag-agent
DOMAIN=localhost
